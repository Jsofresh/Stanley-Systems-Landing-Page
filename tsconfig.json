{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-production/types/**/*.ts",
    ".next-production-candidate/types/**/*.ts",
    ".next-production-candidate2/types/**/*.ts",
    ".next-production-release/types/**/*.ts",
    ".next-production-final/types/**/*.ts",
    ".next-production-deploy/types/**/*.ts",
    ".next-production-final2/types/**/*.ts",
    ".next-production-final3/types/**/*.ts",
    ".next-production-final4/types/**/*.ts",
    ".next-production-final5/types/**/*.ts",
    ".next-production-final6/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
